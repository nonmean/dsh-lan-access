{
  "name": "dsh-lan-access",
  "version": "0.3.0",
  "description": "DSH web plugin: a General-settings toggle that binds the web GUI to all interfaces (LAN access) or back to loopback",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "patches",
    "scripts",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "immediately": true,
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {}
}
